{
  "crons": [
    {
      "path": "/api/alerts/daily-summary",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "runoot.com"
        }
      ],
      "destination": "https://www.runoot.com/:path*",
      "permanent": true
    }
  ]
}
